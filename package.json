{
  "name": "holdt",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Holdt for iCloud Calendar. Reads your calendar. Writes only what it previewed first. Self-hosted MCP server for Grok Bot on Cloudflare Workers.",
  "license": "MIT",
  "scripts": {
    "test": "node --import ./test/register.mjs --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "prove": "node scripts/prove-attacks.mjs",
    "setup": "tsx setup/server.ts",
    "agent-setup": "tsx setup/agent.ts",
    "new-code": "tsx setup/server.ts --new-code",
    "add-device": "tsx setup/server.ts --add-device",
    "reset-passkeys": "tsx setup/server.ts --reset-passkeys",
    "revoke-all": "tsx setup/server.ts --revoke-all",
    "probe:reminders": "tsx scripts/reminders-probe.ts",
    "deploy": "wrangler deploy",
    "cf:login": "wrangler login",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "qrcode-generator": "2.0.4"
  }
}
