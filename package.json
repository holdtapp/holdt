    "setup": "tsx setup/server.ts",
    "probe:reminders": "tsx scripts/reminders-probe.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3"
  }
}
