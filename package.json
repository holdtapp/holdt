{
  "name": "holdt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Holdt for iCloud Calendar. Reads your calendar. Changes nothing until you say yes. Self-hosted MCP server for Grok Bot on Cloudflare Workers.",
